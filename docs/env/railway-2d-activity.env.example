# Railway: 2D Discord Activity (copy into each service → Variables)
# Full steps: docs/RAILWAY-2D-ACTIVITY.md
# Replace YOUR-* placeholders before deploy.

# Discord Developer Portal → OAuth2 redirects (Activities):
#   http://127.0.0.1/callback
#   https://127.0.0.1

# --- jjkbot: API service (same repo, SERVICE=api, volume /data) ---
SERVICE=api
DATABASE_PATH=/data/westeros.db
DISCORD_CLIENT_ID=your_application_id
DISCORD_CLIENT_SECRET=your_oauth_secret
ACTIVITY_ORIGINS=https://YOUR-2D.up.railway.app
ALLOW_DEV_AUTH=false

# --- jjkbot: Web service (optional — dashboard browser link) ---
# GAME_2D_URL=https://YOUR-2D.up.railway.app
# API_PUBLIC_URL=https://YOUR-API.up.railway.app

# --- westeros-game-2d repo: static service (build-time; redeploy after changes) ---
# VITE_API_URL=https://YOUR-API.up.railway.app
# VITE_DISCORD_CLIENT_ID=your_application_id
# Do NOT set VITE_DEV_DISCORD_ID in production.
