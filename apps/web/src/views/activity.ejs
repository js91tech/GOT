<%- include('partials/head', { loggedIn: false, title: 'Westeros Realm', pageClass: 'page-realm page-activity' }) %>
<%- include('partials/realm-shell-open') %>
<script>
  document.body.dataset.discordClientId = '<%= discordClientId %>';
  document.body.dataset.activityAuthUrl = '/activity/auth';
</script>

<article class="realm-panel vine-panel activity-panel" style="max-width:520px;margin:2rem auto;text-align:center">
  <h1 class="page-title">Westeros Realm</h1>
  <p class="page-lead" id="activity-status">Connecting to Discord…</p>
  <p class="stat activity-fallback" id="activity-fallback" hidden>
    Open this page from a Discord Activity (voice channel → Activities), or
    <a href="/login">log in on the web</a>.
  </p>
</article>

<%- include('partials/realm-shell-close') %>
<%- include('partials/foot') %>
<script type="module" src="/public/activity-boot.js"></script>
