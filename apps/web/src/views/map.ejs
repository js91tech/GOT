<%- include('partials/head', { loggedIn: true, title: 'Realm Map', pageClass: 'page-realm page-map' }) %>
<link rel="stylesheet" href="/public/map/map.css" />
<%- include('partials/realm-shell-open') %>

<div class="dash-page">
  <% if (msg) { %><div class="map-flash"><%= msg %></div><% } %>

  <% if (!player.faction_id) { %>
  <section class="map-panel house-pick" style="max-width:400px;margin-bottom:1rem">
    <h2>Choose your Great House</h2>
    <form method="post" action="/map/join-house">
      <select name="faction_id" required>
        <% factions.forEach(function(f) { %>
        <option value="<%= f.id %>"><%= f.name %> — <%= f.motto %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn-stone">Pledge allegiance</button>
    </form>
  </section>
  <% } %>

  <div class="map-layout">
    <div class="map-canvas-wrap">
      <div class="map-view-tabs">
        <button type="button" class="map-tab active" data-view="interactive">Holdings map</button>
        <button type="button" class="map-tab" data-view="overview">All lands &amp; resources</button>
      </div>
      <div id="realm-map" class="map-view map-view-interactive" data-map-url="/public/map/realm-world.png"></div>
      <div id="realm-map-overview" class="map-view map-view-overview" hidden></div>
    </div>
    <aside id="map-detail" class="map-panel">
      <h2>Realm</h2>
      <p class="meta">Click a holding on the map.</p>
    </aside>
  </div>

  <p style="margin-top:1rem"><a href="/dashboard">← Dashboard</a></p>
</div>

<script>
  window.__realmMapData = <%- JSON.stringify({ territories, factions, player, guild }) %>;
</script>
<script src="/public/map/map.js" defer></script>

<%- include('partials/realm-shell-close') %>
<%- include('partials/foot') %>
