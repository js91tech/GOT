<%- include('partials/head', { loggedIn: true, title: 'Realm Map', pageClass: 'page-realm page-map' }) %>
<link rel="stylesheet" href="<%= assetUrl('/public/map/map.css') %>" />
<%- include('partials/realm-shell-open') %>

<div class="dash-page map-page">
  <% if (msg) { %><div class="map-flash"><%= msg %></div><% } %>

  <section class="map-status-strip" aria-label="Realm status">
    <% if (house) { %>
    <span class="map-status-chip"><%= house.name %></span>
    <% } else { %>
    <span class="map-status-chip map-status-chip--warn">No house pledged</span>
    <% } %>
    <% if (guild) { %>
    <span class="map-status-chip">Guild: [<%= guild.tag %>] <%= guild.name %></span>
    <% } else { %>
    <span class="map-status-chip map-status-chip--muted">No guild</span>
    <% } %>
    <% if (war && war.siege) { %>
    <span class="map-status-chip map-status-chip--siege">Siege: <%= war.siege.display_name %></span>
    <% } %>
  </section>

  <% if (!player.faction_id) { %>
  <section class="map-panel house-pick">
    <h2>Choose your Great House</h2>
    <form method="post" action="/map/join-house">
      <select name="faction_id" required>
        <% factions.forEach(function(f) { %>
        <option value="<%= f.id %>"><%= f.name %> — <%= f.motto %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn-stone">Pledge allegiance</button>
    </form>
  </section>
  <% } %>

  <% if (guild && war && war.siege) { %>
  <section class="map-war-panel map-panel">
    <h2>Siege in progress</h2>
    <p class="map-war-target"><strong><%= war.siege.display_name %></strong></p>
    <div class="map-siege-bar" aria-label="Siege progress">
      <span class="map-siege-fill" style="width:<%= Math.min(100, Math.round((war.siege.progress / war.siege.target) * 100)) %>%"></span>
    </div>
    <p class="map-war-meta"><%= war.siege.progress %> / <%= war.siege.target %> · ends <%= war.siege.ends_at %></p>
    <form method="post" action="/map/reinforce">
      <button type="submit" class="btn-realm">Reinforce siege</button>
    </form>
  </section>
  <% } else if (guild) { %>
  <section class="map-war-panel map-panel map-war-panel--idle">
    <h2>Guild war</h2>
    <p class="map-war-meta">No active siege. Click a holding on the map to declare war (guild required).</p>
  </section>
  <% } %>

  <div class="map-layout">
    <div class="map-canvas-wrap">
      <div class="map-view-tabs">
        <button type="button" class="map-tab active" data-view="interactive">Holdings map</button>
        <button type="button" class="map-tab" data-view="overview">All lands &amp; resources</button>
      </div>
      <div id="realm-map" class="map-view map-view-interactive" data-map-url="/public/map/realm-world.png"></div>
      <div id="realm-map-overview" class="map-view map-view-overview" hidden></div>
    </div>
    <aside id="map-detail" class="map-panel">
      <h2>Realm</h2>
      <p class="meta">Click a holding on the map.</p>
    </aside>
  </div>

  <p class="map-back-link"><a href="/dashboard">← Dashboard</a></p>
</div>

<script>
  window.__realmMapData = <%- JSON.stringify({ territories, factions, player, guild }) %>;
</script>
<script src="/public/map/map.js" defer></script>

<%- include('partials/realm-shell-close') %>
<%- include('partials/foot') %>
