<%- include('partials/head', { loggedIn: false, title: 'Westeros Realm', pageClass: 'page-realm' }) %>
<%- include('partials/realm-shell-open') %>

<div class="home-hero">
  <img class="home-banner" src="/public/assets/hero-realm.svg" alt="Westeros Realm" width="800" height="240" />
  <article class="vine-panel realm-panel">
    <h1>Westeros Realm</h1>
    <p class="stat">Feudal strategy MUD · Great Houses · guild wars · territory map</p>
  </article>
  <div class="house-crest-grid home-crests">
    <img src="/public/assets/crests/stark.svg" alt="House Stark" width="48" height="48" />
    <img src="/public/assets/crests/lannister.svg" alt="House Lannister" width="48" height="48" />
    <img src="/public/assets/crests/baratheon.svg" alt="House Baratheon" width="48" height="48" />
    <img src="/public/assets/crests/tyrell.svg" alt="House Tyrell" width="48" height="48" />
    <img src="/public/assets/crests/greyjoy.svg" alt="House Greyjoy" width="48" height="48" />
    <img src="/public/assets/crests/targaryen.svg" alt="House Targaryen" width="48" height="48" />
  </div>
  <p class="page-lead" style="text-align:center;max-width:520px;margin:0 auto 1.5rem">
    Swear fealty to a Great House, train your lord, raid rivals, and contest land for grain, iron, and gold — one save across Discord and the web.
  </p>
  <a class="btn btn-realm" href="/login" style="display:inline-block;text-decoration:none">Login with Discord</a>
</div>

<%- include('partials/realm-shell-close') %>
<%- include('partials/foot') %>
