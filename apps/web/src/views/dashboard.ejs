<%- include('partials/head', { loggedIn: true, title: 'Dashboard', pageClass: 'page-realm page-dashboard' }) %>
<%- include('partials/realm-shell-open') %>

<div class="dash-page">
  <span class="dash-ornament dash-ornament--tl" aria-hidden="true"></span>
  <span class="dash-ornament dash-ornament--tr" aria-hidden="true"></span>

  <% if (flash) { %>
  <div class="flash-wrap <%= flashOk ? '' : 'error' %>">
    <% if (flashGif) { %><img class="flash-gif" src="<%= flashGif %>" alt="Action" loading="lazy" /><% } %>
    <div class="flash-text"><%= flash %></div>
  </div>
  <% } %>

  <% if (confinement && confinement.confined) { %>
  <section class="alert-panel vine-frame">
    <h3><%= confinement.reason === 'jail' ? '⛓ The Black Cells' : '🏥 Maester\'s Tent' %></h3>
    <p><strong><%= confinement.minutesLeft %> minutes</strong> remaining · until <%= confinement.until %></p>
    <div class="escape-actions">
      <% if (confinement.reason === 'hospital') { %>
        <form method="post" action="/escape"><input type="hidden" name="place" value="hospital" /><input type="hidden" name="method" value="pay" /><button type="submit" class="btn-stone">Pay medical bill</button></form>
        <form method="post" action="/escape"><input type="hidden" name="place" value="hospital" /><input type="hidden" name="method" value="ce" /><button type="submit" class="btn-wood">Rally morale (40)</button></form>
        <form method="post" action="/escape"><input type="hidden" name="place" value="hospital" /><input type="hidden" name="method" value="item" /><button type="submit" class="btn-wood">Use Reversal Kit</button></form>
      <% } else { %>
        <form method="post" action="/escape"><input type="hidden" name="place" value="jail" /><input type="hidden" name="method" value="pay" /><button type="submit" class="btn-stone">Pay bail</button></form>
        <form method="post" action="/escape"><input type="hidden" name="place" value="jail" /><input type="hidden" name="method" value="item" /><button type="submit" class="btn-wood">Prison Key</button></form>
        <a class="btn-wood" href="/pvp">Ask ally to bust you</a>
      <% } %>
    </div>
  </section>
  <% } %>

  <section class="profile-panel vine-frame">
    <div class="profile-inner profile-inner--crest">
      <% if (typeof houseCrest !== 'undefined' && houseCrest) { %>
      <img class="profile-crest" src="<%= houseCrest %>" alt="<%= house.name %>" width="72" height="72" />
      <% } %>
      <div class="profile-text">
      <h1 class="profile-name"><%= player.username %> <span class="grade-tag"><%= player.grade %></span></h1>
      <p class="profile-meta">Level <%= player.level %><% if (typeof house !== 'undefined' && house) { %> · <%= house.name %><% } %> · Yard: <%= player.gym_id %></p>
      <div class="profile-actions profile-actions--2d">
        <p class="play-2d-primary"><strong>Play in Discord:</strong> join a voice channel → <strong>Activities</strong> (rocket) → Westeros Realm</p>
        <% if (launch2dUrl) { %>
        <a href="<%= launch2dUrl %>" class="btn-launch-2d" target="_blank" rel="noopener noreferrer" data-tip="Optional browser link to the hosted 2D client. Main path is Discord Activity in a voice channel.">Open 2D in browser</a>
        <% } %>
        <span class="profile-sync"><%= launch2dHint %></span>
      </div>
      </div>
    </div>
  </section>

  <section class="resource-row" aria-label="Resources">
    <div class="resource-stone" data-icon="coins">
      <span class="resource-icon" aria-hidden="true"></span>
      <span class="resource-label">Coins</span>
      <span class="resource-value"><%= player.coins.toLocaleString() %></span>
    </div>
    <div class="resource-stone" data-icon="bank">
      <span class="resource-icon" aria-hidden="true"></span>
      <span class="resource-label">Bank</span>
      <span class="resource-value"><%= player.bank_balance.toLocaleString() %></span>
    </div>
    <div class="resource-stone resource-stone--ce" data-icon="ce">
      <span class="resource-icon" aria-hidden="true"></span>
      <span class="resource-label">Morale</span>
      <span class="resource-value"><%= player.ce %>/100</span>
    </div>
    <div class="resource-stone" data-icon="focus">
      <span class="resource-icon" aria-hidden="true"></span>
      <span class="resource-label">Focus</span>
      <span class="resource-value"><%= player.focus %></span>
    </div>
    <div class="resource-stone" data-icon="wheel">
      <span class="resource-icon" aria-hidden="true"></span>
      <span class="resource-label">Wheel spins</span>
      <span class="resource-value"><%= status.wheel_spins_left %></span>
    </div>
    <div class="resource-stone" data-icon="company">
      <span class="resource-icon" aria-hidden="true"></span>
      <span class="resource-label">Company</span>
      <span class="resource-value resource-value--sm"><%= player.company_id || '—' %></span>
    </div>
  </section>

  <section class="combat-slab metal-frame">
    <div class="combat-stats">
      <span>STR <strong><%= player.strength %></strong></span>
      <span>DEF <strong><%= player.defense %></strong></span>
      <span>SPD <strong><%= player.speed %></strong></span>
      <span>DEX <strong><%= player.dexterity %></strong></span>
    </div>
    <p class="worker-line">Worker — LAB <strong><%= player.manual_labor %></strong> · INT <strong><%= player.intelligence %></strong> · END <strong><%= player.endurance %></strong> · TEC <strong><%= player.technique %></strong></p>
  </section>

  <section class="action-row">
    <article class="action-tile stone-frame action-tile--train">
      <h3>Train combat</h3>
      <div class="tile-art tile-art--train" aria-hidden="true"></div>
      <form method="post" action="/train" class="tile-form">
        <select name="stat">
          <option value="strength">Strength</option>
          <option value="defense">Defense</option>
          <option value="speed">Speed</option>
          <option value="dexterity">Dexterity</option>
        </select>
        <input type="number" name="sets" value="5" min="1" max="20" aria-label="Sets" />
        <button type="submit" class="btn-realm">Train</button>
      </form>
    </article>

    <article class="action-tile wood-frame action-tile--mission">
      <h3>Realm mission</h3>
      <div class="tile-art tile-art--mission" style="background-image:url('<%= typeof missionImage !== "undefined" ? missionImage : heroImage %>')" aria-hidden="true"></div>
      <form method="post" action="/crime" class="tile-form">
        <select name="mission">
          <% crimes.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= c.locked ? 'disabled' : '' %>><%= c.name %> (Lv<%= c.min_level %>)<%= c.locked ? ' 🔒' : '' %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn-realm">Run</button>
      </form>
    </article>

    <article class="action-tile wood-frame action-tile--worker">
      <h3>Worker training</h3>
      <div class="tile-art tile-art--worker" aria-hidden="true"></div>
      <form method="post" action="/worker" class="tile-form">
        <select name="stat">
          <option value="manual_labor">Labor</option>
          <option value="intelligence">Intelligence</option>
          <option value="endurance">Endurance</option>
          <option value="technique">Technique</option>
        </select>
        <input type="number" name="sets" value="3" min="1" max="20" aria-label="Sets" />
        <button type="submit" class="btn-wood">Train</button>
      </form>
    </article>

    <article class="action-tile action-tile--wheel">
      <h3>Wheel</h3>
      <form method="post" action="/wheel" class="wheel-form">
        <button type="submit" class="wheel-btn" aria-label="Spin wheel">
          <span class="wheel-disc" aria-hidden="true"></span>
          <span class="wheel-label">Spin</span>
        </button>
      </form>
      <form method="post" action="/work" class="work-chip">
        <button type="submit" class="btn-wood">Clock in</button>
      </form>
    </article>
  </section>

  <section class="bottom-row">
    <article class="lounge-panel glow-purple vine-frame">
      <h3>War Camp</h3>
      <p class="panel-sub">Rest &amp; rally</p>
      <div class="lounge-actions">
        <form method="post" action="/lounge">
          <input type="hidden" name="action" value="tea" />
          <button type="submit" class="lounge-btn" data-icon="tea"><span>Feast</span><em>Tea</em></button>
        </form>
        <form method="post" action="/lounge">
          <input type="hidden" name="action" value="vow" />
          <button type="submit" class="lounge-btn" data-icon="vow"><span>Oath</span><em>Vow</em></button>
        </form>
        <form method="post" action="/lounge">
          <input type="hidden" name="action" value="refill" />
          <button type="submit" class="lounge-btn" data-icon="refill"><span>Morale</span><em>Refill</em></button>
        </form>
      </div>
    </article>

    <article class="shelf-panel wood-shelf">
      <h3>Treasury</h3>
      <p class="panel-sub">Vault &amp; investments</p>
      <div class="shelf-deco" aria-hidden="true"></div>
      <form method="post" action="/bank" class="tile-form">
        <select name="action">
          <option value="deposit">Deposit</option>
          <option value="withdraw">Withdraw</option>
          <option value="invest">Invest</option>
          <option value="collect">Collect</option>
        </select>
        <input type="number" name="amount" placeholder="Amount" />
        <button type="submit" class="btn-wood">Go</button>
      </form>
    </article>

    <article class="shelf-panel wood-shelf gear-shelf">
      <h3>Armory</h3>
      <p class="panel-sub">Equip &amp; training yard</p>
      <div class="shelf-deco gear-deco" aria-hidden="true"></div>
      <form method="post" action="/gym" class="tile-form tile-form--inline">
        <input type="hidden" name="gymId" value="cursed_pit" />
        <button type="submit" class="btn-wood">War yard</button>
      </form>
      <form method="post" action="/equip" class="tile-form">
        <input name="item" placeholder="item id" />
        <button type="submit" class="btn-realm">Equip</button>
      </form>
    </article>

    <aside class="inventory-panel stone-frame">
      <h3>Inventory</h3>
      <ul class="inventory-list">
        <% inventory.forEach(function(i) { %>
          <li>
            <span class="inv-icon" aria-hidden="true"></span>
            <span class="inv-text"><%= i.name %> ×<%= i.quantity %><% if (i.equip_slot) { %> <em>(<%= i.equip_slot %>)</em><% } %></span>
          </li>
        <% }); %>
        <% if (!inventory.length) { %>
          <li class="inv-empty">Empty — <a href="/shop">visit shop</a></li>
        <% } %>
      </ul>
    </aside>
  </section>
</div>

<%- include('partials/realm-shell-close') %>
<%- include('partials/foot') %>
