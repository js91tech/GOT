<%- include('partials/head', { loggedIn: true, title: 'Dashboard', pageClass: 'page-realm page-dashboard' }) %>
<%- include('partials/realm-shell-open') %>

<div class="dash-page dash-studio">
  <% if (flash) { %>
  <div class="flash-wrap <%= flashOk ? '' : 'error' %>">
    <% if (flashGif) { %><img class="flash-gif" src="<%= flashGif %>" alt="" loading="lazy" /><% } %>
    <div class="flash-text"><%= flash %></div>
  </div>
  <% } %>

  <% if (confinement && confinement.confined) { %>
  <section class="alert-panel">
    <h3><%= confinement.reason === 'jail' ? 'The Black Cells' : "Maester's Tent" %></h3>
    <p><strong><%= confinement.minutesLeft %> minutes</strong> remaining · until <%= confinement.until %></p>
    <div class="escape-actions">
      <% if (confinement.reason === 'hospital') { %>
        <form method="post" action="/escape"><input type="hidden" name="place" value="hospital" /><input type="hidden" name="method" value="pay" /><button type="submit" class="btn-stone">Pay medical bill</button></form>
        <form method="post" action="/escape"><input type="hidden" name="place" value="hospital" /><input type="hidden" name="method" value="ce" /><button type="submit" class="btn-wood">Rally morale (40)</button></form>
        <form method="post" action="/escape"><input type="hidden" name="place" value="hospital" /><input type="hidden" name="method" value="item" /><button type="submit" class="btn-wood">Healer's kit</button></form>
      <% } else { %>
        <form method="post" action="/escape"><input type="hidden" name="place" value="jail" /><input type="hidden" name="method" value="pay" /><button type="submit" class="btn-stone">Pay bail</button></form>
        <form method="post" action="/escape"><input type="hidden" name="place" value="jail" /><input type="hidden" name="method" value="item" /><button type="submit" class="btn-wood">Dungeon Key</button></form>
        <a class="btn-wood" href="/pvp">Ask ally to bust you</a>
      <% } %>
    </div>
  </section>
  <% } %>

  <section class="profile-panel">
    <div class="profile-inner profile-inner--crest">
      <div class="profile-avatars">
        <img class="profile-portrait" src="<%= playerPortrait %>" alt="<%= player.username %>" width="72" height="72" />
        <% if (typeof houseCrest !== 'undefined' && houseCrest) { %>
        <img class="profile-crest" src="<%= houseCrest %>" alt="<%= house.name %>" width="72" height="72" />
        <% } %>
      </div>
      <div class="profile-text">
        <h1 class="profile-name">
          <%= player.username %>
          <span class="grade-tag"><%= player.grade %></span>
          <% if (typeof classInfo !== 'undefined' && classInfo) { %>
          <span class="class-badge" title="<%= classInfo.description %>">
            <img class="class-badge-icon" src="<%= classIcon %>" alt="" width="22" height="22" />
            <%= classInfo.name %>
          </span>
          <% } %>
        </h1>
        <p class="profile-meta">Level <%= player.level %><% if (typeof house !== 'undefined' && house) { %> · <%= house.name %><% } %> · <%= player.gym_id.replace(/_/g, ' ') %> · <a href="/class">Class path</a></p>
        <p class="play-2d-primary"><strong>Play in Discord:</strong> voice channel → Activities → Westeros Realm</p>
        <% if (launch2dUrl) { %>
        <a href="<%= launch2dUrl %>" class="btn-launch-2d" target="_blank" rel="noopener noreferrer">Open 2D in browser</a>
        <% } %>
      </div>
    </div>
  </section>

  <section class="resource-row" aria-label="Resources">
    <div class="resource-stone" data-icon="coins">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/gold.svg') %>" alt="Gold coins" width="40" height="40" /></div>
      <span class="resource-label">Coins</span>
      <span class="resource-value"><%= player.coins.toLocaleString() %></span>
    </div>
    <div class="resource-stone" data-icon="bank">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/vault.svg') %>" alt="Treasury vault" width="40" height="40" /></div>
      <span class="resource-label">Treasury</span>
      <span class="resource-value"><%= player.bank_balance.toLocaleString() %></span>
    </div>
    <div class="resource-stone resource-stone--ce<%= player.ce <= status.morale_regen_cap * 0.25 ? ' resource-stone--ce-low' : '' %>" data-icon="ce">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/morale.svg') %>" alt="Morale" width="40" height="40" /></div>
      <span class="resource-label">Morale</span>
      <span class="resource-value"><%= player.ce %>/<%= player.ce > status.morale_regen_cap ? status.morale_overflow_cap : status.morale_regen_cap %></span>
    </div>
    <div class="resource-stone" data-icon="focus">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/focus.svg') %>" alt="Focus" width="40" height="40" /></div>
      <span class="resource-label">Focus</span>
      <span class="resource-value"><%= player.focus %>/<%= player.focus > status.focus_regen_cap ? status.focus_overflow_cap : status.focus_regen_cap %></span>
    </div>
    <div class="resource-stone" data-icon="wheel">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/wheel.svg') %>" alt="Wheel of fate" width="40" height="40" /></div>
      <span class="resource-label">Wheel</span>
      <span class="resource-value"><%= status.wheel_spins_left %></span>
    </div>
    <div class="resource-stone" data-icon="company">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/company.svg') %>" alt="Company" width="40" height="40" /></div>
      <span class="resource-label">Company</span>
      <span class="resource-value resource-value--sm"><%= player.company_id || '—' %></span>
    </div>
  </section>

  <section class="combat-slab">
    <div class="combat-stats">
      <span>STR <strong><%= sheet.combat.effective.strength %></strong><% if (sheet.combat.gear.strength) { %> <em class="gear-bonus">(+<%= sheet.combat.gear.strength %>)</em><% } %></span>
      <span>DEF <strong><%= sheet.combat.effective.defense %></strong><% if (sheet.combat.gear.defense) { %> <em class="gear-bonus">(+<%= sheet.combat.gear.defense %>)</em><% } %></span>
      <span>SPD <strong><%= sheet.combat.effective.speed %></strong><% if (sheet.combat.gear.speed) { %> <em class="gear-bonus">(+<%= sheet.combat.gear.speed %>)</em><% } %></span>
      <span>DEX <strong><%= sheet.combat.effective.dexterity %></strong><% if (sheet.combat.gear.dexterity) { %> <em class="gear-bonus">(+<%= sheet.combat.gear.dexterity %>)</em><% } %></span>
      <span class="power-chip">Power <%= sheet.power %></span>
    </div>
    <p class="worker-line">Worker — LAB <strong><%= sheet.worker.effective.manual_labor %></strong> · INT <strong><%= sheet.worker.effective.intelligence %></strong> · END <strong><%= sheet.worker.effective.endurance %></strong> · TEC <strong><%= sheet.worker.effective.technique %></strong></p>
    <p class="worker-line"><a href="/character">Full character sheet</a> · <a href="/armory">Armory</a></p>
  </section>

  <section class="action-row">
    <article class="action-tile action-tile--train">
      <h3>Train combat</h3>
      <div class="tile-art tile-art--train" aria-hidden="true"></div>
      <form method="post" action="/train" class="tile-form">
        <select name="stat">
          <option value="strength">Strength</option>
          <option value="defense">Defense</option>
          <option value="speed">Speed</option>
          <option value="dexterity">Dexterity</option>
        </select>
        <input type="number" name="sets" value="5" min="1" max="20" aria-label="Sets" />
        <button type="submit" class="btn-realm">Train</button>
      </form>
    </article>

    <article class="action-tile action-tile--mission">
      <h3>Realm mission</h3>
      <div class="tile-art tile-art--mission" aria-hidden="true"></div>
      <form method="post" action="/crime" class="tile-form">
        <select name="mission">
          <% crimes.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= c.locked ? 'disabled' : '' %>><%= c.name %> (Lv<%= c.min_level %>)<%= c.locked ? ' 🔒' : '' %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn-realm">Run</button>
      </form>
    </article>

    <article class="action-tile action-tile--worker">
      <h3>Worker training</h3>
      <div class="tile-art tile-art--worker" aria-hidden="true"></div>
      <form method="post" action="/worker" class="tile-form">
        <select name="stat">
          <option value="manual_labor">Labor</option>
          <option value="intelligence">Intelligence</option>
          <option value="endurance">Endurance</option>
          <option value="technique">Technique</option>
        </select>
        <input type="number" name="sets" value="3" min="1" max="20" aria-label="Sets" />
        <button type="submit" class="btn-wood">Train</button>
      </form>
    </article>

    <article class="action-tile action-tile--wheel">
      <h3>Wheel of fate</h3>
      <form method="post" action="/wheel" class="wheel-form">
        <button type="submit" class="wheel-btn" aria-label="Spin wheel">
          <span class="wheel-disc" aria-hidden="true"></span>
          <span class="wheel-label">Spin</span>
        </button>
      </form>
      <form method="post" action="/work" class="work-chip">
        <button type="submit" class="btn-wood">Clock in</button>
      </form>
    </article>
  </section>

  <section class="bottom-row">
    <article class="lounge-panel">
      <h3>War Camp</h3>
      <p class="panel-sub">Rest &amp; rally</p>
      <div class="lounge-actions">
        <form method="post" action="/lounge">
          <input type="hidden" name="action" value="tea" />
          <button type="submit" class="lounge-btn">
            <img class="lounge-icon" src="<%= assetUrl('/public/assets/icons/feast.svg') %>" alt="Feast" width="32" height="32" />
            <span>Feast</span><em>+Focus</em>
          </button>
        </form>
        <form method="post" action="/lounge">
          <input type="hidden" name="action" value="vow" />
          <button type="submit" class="lounge-btn">
            <img class="lounge-icon" src="<%= assetUrl('/public/assets/icons/oath.svg') %>" alt="Oath of fealty" width="32" height="32" />
            <span>Oath of fealty</span><em>+Bravery</em>
          </button>
        </form>
        <form method="post" action="/lounge">
          <input type="hidden" name="action" value="refill" />
          <button type="submit" class="lounge-btn">
            <img class="lounge-icon" src="<%= assetUrl('/public/assets/icons/rally.svg') %>" alt="Rally morale" width="32" height="32" />
            <span>Rally morale</span><em>Full bar</em>
          </button>
        </form>
      </div>
    </article>

    <article class="shelf-panel wood-shelf">
      <h3>Treasury</h3>
      <p class="panel-sub">Vault &amp; investments</p>
      <form method="post" action="/bank" class="tile-form">
        <select name="action">
          <option value="deposit">Deposit</option>
          <option value="withdraw">Withdraw</option>
          <option value="invest">Invest</option>
          <option value="collect">Collect</option>
        </select>
        <input type="number" name="amount" placeholder="Amount" />
        <button type="submit" class="btn-wood">Go</button>
      </form>
    </article>

    <article class="shelf-panel wood-shelf gear-shelf">
      <h3>Armory</h3>
      <p class="panel-sub">Equip &amp; war yard</p>
      <form method="post" action="/gym" class="tile-form tile-form--inline">
        <input type="hidden" name="gymId" value="war_yard" />
        <button type="submit" class="btn-wood">War yard</button>
      </form>
      <form method="post" action="/equip" class="tile-form">
        <select name="item" aria-label="Item to equip">
          <option value="">— Select gear —</option>
          <% equippable.forEach(function(i) { %>
          <option value="<%= i.item_id %>"><%= i.name %> ×<%= i.quantity %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn-realm" <%= equippable.length ? '' : 'disabled' %>>Equip</button>
      </form>
    </article>

    <aside class="inventory-panel">
      <h3>Inventory</h3>
      <ul class="inventory-list">
        <% inventory.forEach(function(i) { %>
          <li>
            <img class="inv-icon-img" src="<%= i.iconUrl %>" alt="" width="36" height="36" loading="lazy" />
            <span class="inv-text"><%= i.name %> ×<%= i.quantity %><% if (i.equip_slot) { %> <em>(<%= i.equip_slot %>)</em><% } %></span>
          </li>
        <% }); %>
        <% if (!inventory.length) { %>
          <li class="inv-empty">Empty — <a href="/shop">visit shop</a></li>
        <% } %>
      </ul>
    </aside>
  </section>
</div>

<%- include('partials/realm-shell-close') %>
<%- include('partials/foot') %>
