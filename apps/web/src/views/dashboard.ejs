<%- include('partials/head', { loggedIn: true, title: 'Dashboard', pageClass: 'page-realm page-dashboard' }) %>
<%- include('partials/realm-shell-open') %>

<div class="dash-page dash-studio<%= typeof house !== 'undefined' && house ? ' dash-house-' + house.id : '' %>">
  <% if (flash) { %>
  <div class="flash-wrap <%= flashOk ? '' : 'error' %>">
    <% if (flashGif) { %><img class="flash-gif" src="<%= flashGif %>" alt="" loading="lazy" /><% } %>
    <div class="flash-text"><%= flash %></div>
  </div>
  <% } %>

  <% if (typeof classMilestone !== 'undefined' && classMilestone && classMilestone.due) { %>
  <div class="milestone-banner">
    <a href="/class">Choose your next class specialization →</a>
  </div>
  <% } %>

  <% if (confinement && confinement.confined) { %>
  <section class="alert-panel" data-confinement-until="<%= confinement.until %>">
    <h3><%= confinement.reason === 'jail' ? 'The Black Cells' : "Maester's Tent" %></h3>
    <p><strong class="confinement-mins"><%= confinement.minutesLeft %></strong> minutes remaining · until <%= confinement.until %></p>
    <div class="escape-actions">
      <% if (confinement.reason === 'hospital') { %>
        <form method="post" action="/escape"><input type="hidden" name="place" value="hospital" /><input type="hidden" name="method" value="pay" /><button type="submit" class="btn-stone">Pay medical bill</button></form>
        <form method="post" action="/escape"><input type="hidden" name="place" value="hospital" /><input type="hidden" name="method" value="ce" /><button type="submit" class="btn-wood">Rally morale (40)</button></form>
        <form method="post" action="/escape"><input type="hidden" name="place" value="hospital" /><input type="hidden" name="method" value="item" /><button type="submit" class="btn-wood">Healer's kit</button></form>
      <% } else { %>
        <form method="post" action="/escape"><input type="hidden" name="place" value="jail" /><input type="hidden" name="method" value="pay" /><button type="submit" class="btn-stone">Pay bail</button></form>
        <form method="post" action="/escape"><input type="hidden" name="place" value="jail" /><input type="hidden" name="method" value="item" /><button type="submit" class="btn-wood">Dungeon Key</button></form>
        <a class="btn-wood" href="/pvp">Ask ally to bust you</a>
      <% } %>
    </div>
  </section>
  <% } %>

  <section class="profile-panel">
    <div class="profile-inner profile-inner--crest">
      <div class="profile-avatars">
        <img class="profile-portrait" src="<%= playerPortrait %>" alt="<%= player.username %>" width="72" height="72" />
        <% if (typeof houseCrest !== 'undefined' && houseCrest) { %>
        <img class="profile-crest" src="<%= houseCrest %>" alt="<%= house.name %>" width="72" height="72" />
        <% } %>
      </div>
      <div class="profile-text">
        <h1 class="profile-name">
          <%= player.username %>
          <span class="grade-tag"><%= player.grade %></span>
          <% if (typeof classInfo !== 'undefined' && classInfo) { %>
          <span class="class-badge" title="<%= classInfo.description %>">
            <img class="class-badge-icon" src="<%= classIcon %>" alt="" width="22" height="22" />
            <%= classInfo.name %>
          </span>
          <% } %>
        </h1>
        <p class="profile-meta">
          Level <%= player.level %>
          <% if (!status.at_cap) { %> · <%= status.xp_current %>/<%= status.xp_needed %> XP<% } else { %> · max level<% } %>
          <% if (typeof house !== 'undefined' && house) { %> · <%= house.name %><% } %>
          · <%= status.gym_name || status.gym_id %>
          · Job: <%= status.job_name || 'Stable Hand' %>
          · <a href="/class">Class path</a>
        </p>
        <% if (!status.at_cap) { %>
        <div class="xp-bar" aria-label="XP progress">
          <span class="xp-bar-fill" style="width:<%= status.xp_pct %>%"></span>
          <span class="xp-bar-label"><%= status.xp_pct %>% to Lv.<%= player.level + 1 %></span>
        </div>
        <% } %>
        <p class="play-2d-primary"><strong>Play in Discord:</strong> voice channel → Activities → Westeros Realm</p>
        <% if (launch2dUrl) { %>
        <a href="<%= launch2dUrl %>" class="btn-launch-2d" target="_blank" rel="noopener noreferrer">Open 2D in browser</a>
        <% } %>
      </div>
    </div>
  </section>

  <section class="status-strip" aria-label="Status">
    <% if (status.login_streak > 1) { %>
    <span class="status-chip status-chip--streak" title="Daily login: +<%= dailyLoginBonus.coins %> coins, +<%= dailyLoginBonus.xp %> XP">🔥 Day <%= status.login_streak %></span>
    <% } else { %>
    <span class="status-chip status-chip--streak" title="Return tomorrow to build your streak">Daily +<%= dailyLoginBonus.coins %>c</span>
    <% } %>
    <% if (status.work_ready) { %>
    <span class="status-chip status-chip--ok">Work ready</span>
    <% } else { %>
    <span class="status-chip status-chip--wait" data-work-until="<%= status.work_ready_at %>">Work in <%= status.work_minutes_left %>m</span>
    <% } %>
    <span class="status-chip">Wheel ×<%= status.wheel_spins_left %></span>
    <% if (status.morale_regen_at && player.ce < status.morale_regen_cap) { %>
    <span class="status-chip status-chip--wait" data-countdown-until="<%= status.morale_regen_at %>" data-countdown-prefix="Morale +5 in " data-countdown-done="Morale regen ready">Morale +5 in <%= status.morale_regen_in %>m</span>
    <% } %>
    <% if (status.focus_regen_at && player.focus < status.focus_regen_cap) { %>
    <span class="status-chip status-chip--wait" data-countdown-until="<%= status.focus_regen_at %>" data-countdown-prefix="Focus +2 in " data-countdown-done="Focus regen ready">Focus +2 in <%= status.focus_regen_in %>m</span>
    <% } %>
    <% if (status.delve_active) { %>
    <span class="status-chip status-chip--invest">Crypt delve · depth <%= status.delve_depth %></span>
    <% } %>
    <% if (status.investment_amount) { %>
    <span class="status-chip status-chip--invest">Invested <%= status.investment_amount.toLocaleString() %></span>
    <% if (status.investment_mature) { %>
    <span class="status-chip status-chip--ok">Investment ready — collect</span>
    <% } else { %>
    <span class="status-chip status-chip--invest" data-countdown-until="<%= status.investment_matures_at %>" data-countdown-prefix="Matures in " data-countdown-done="Collect now">Matures in <%= status.investment_minutes_left %>m</span>
    <% } %>
    <% } %>
    <% drugCooldownChips.forEach(function(d) { %>
    <span class="status-chip status-chip--wait"><%= d.name %> <%= d.minutes %>m</span>
    <% }); %>
    <% if (status.blocked && status.blocked.blocked) { %>
    <span class="status-chip status-chip--warn"><%= status.blocked.reason === 'jail' ? 'Black Cells' : "Maester's Tent" %></span>
    <% } %>
  </section>

  <% if (status.daily_quests && status.daily_quests.length) { %>
  <section class="daily-quests-strip" aria-label="Daily quests">
    <h3 class="daily-quests-title">Daily quests</h3>
    <div class="daily-quests-row">
      <% status.daily_quests.forEach(function(q) { %>
      <article class="daily-quest-card <%= q.claimed ? 'daily-quest-card--claimed' : (q.done ? 'daily-quest-card--done' : '') %>">
        <span class="daily-quest-label"><%= q.label %></span>
        <span class="daily-quest-progress"><%= q.progress %>/<%= q.target %></span>
        <% if (q.claimed) { %>
        <span class="daily-quest-status">Claimed</span>
        <% } else if (q.done) { %>
        <form method="post" action="/daily-quest" class="daily-quest-claim">
          <input type="hidden" name="questId" value="<%= q.id %>" />
          <button type="submit" class="btn-wood btn-sm">Claim +<%= q.coins %>c</button>
        </form>
        <% } else { %>
        <span class="daily-quest-status">In progress</span>
        <% } %>
      </article>
      <% }); %>
    </div>
  </section>
  <% } %>

  <section class="resource-row" aria-label="Resources">
    <% var moraleCap = player.ce > status.morale_regen_cap ? status.morale_overflow_cap : status.morale_regen_cap; %>
    <% var moralePct = moraleCap ? Math.min(100, Math.round((player.ce / moraleCap) * 100)) : 0; %>
    <% var focusCap = player.focus > status.focus_regen_cap ? status.focus_overflow_cap : status.focus_regen_cap; %>
    <% var focusPct = focusCap ? Math.min(100, Math.round((player.focus / focusCap) * 100)) : 0; %>
    <div class="resource-stone" data-icon="coins">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/gold.svg') %>" alt="Gold coins" width="40" height="40" /></div>
      <span class="resource-label">Coins</span>
      <span class="resource-value"><%= player.coins.toLocaleString() %></span>
    </div>
    <div class="resource-stone" data-icon="bank">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/vault.svg') %>" alt="Treasury vault" width="40" height="40" /></div>
      <span class="resource-label">Treasury</span>
      <span class="resource-value"><%= player.bank_balance.toLocaleString() %></span>
    </div>
    <div class="resource-stone resource-stone--ce<%= player.ce <= status.morale_regen_cap * 0.25 ? ' resource-stone--ce-low' : '' %>" data-icon="ce">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/morale.svg') %>" alt="Morale" width="40" height="40" /></div>
      <span class="resource-label">Morale</span>
      <span class="resource-value"><%= player.ce %>/<%= moraleCap %></span>
      <div class="resource-meter" aria-hidden="true"><span class="resource-meter-fill resource-meter-fill--morale" style="width:<%= moralePct %>%"></span></div>
    </div>
    <div class="resource-stone" data-icon="focus">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/focus.svg') %>" alt="Focus" width="40" height="40" /></div>
      <span class="resource-label">Focus</span>
      <span class="resource-value"><%= player.focus %>/<%= focusCap %></span>
      <div class="resource-meter" aria-hidden="true"><span class="resource-meter-fill resource-meter-fill--focus" style="width:<%= focusPct %>%"></span></div>
    </div>
    <div class="resource-stone" data-icon="grain">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/items/grain.svg') %>" alt="Grain rations" width="40" height="40" /></div>
      <span class="resource-label">Grain</span>
      <span class="resource-value"><%= player.rice %></span>
    </div>
    <div class="resource-stone" data-icon="wheel">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/wheel.svg') %>" alt="Wheel of fate" width="40" height="40" /></div>
      <span class="resource-label">Wheel</span>
      <span class="resource-value"><%= status.wheel_spins_left %></span>
    </div>
    <div class="resource-stone" data-icon="resolve">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/oath.svg') %>" alt="Resolve" width="40" height="40" /></div>
      <span class="resource-label">Resolve</span>
      <span class="resource-value"><%= status.resolve %></span>
    </div>
    <div class="resource-stone" data-icon="bravery">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/rally.svg') %>" alt="Bravery" width="40" height="40" /></div>
      <span class="resource-label">Bravery</span>
      <span class="resource-value"><%= status.bravery %></span>
    </div>
    <div class="resource-stone" data-icon="company">
      <div class="resource-icon-frame"><img class="resource-icon-img" src="<%= assetUrl('/public/assets/icons/company.svg') %>" alt="Company" width="40" height="40" /></div>
      <span class="resource-label">Company</span>
      <span class="resource-value resource-value--sm"><%= status.company_name || '—' %></span>
    </div>
  </section>

  <section class="combat-slab">
    <div class="combat-stats">
      <span>STR <strong><%= sheet.combat.effective.strength %></strong><% if (sheet.combat.gear.strength) { %> <em class="gear-bonus">(+<%= sheet.combat.gear.strength %>)</em><% } %></span>
      <span>DEF <strong><%= sheet.combat.effective.defense %></strong><% if (sheet.combat.gear.defense) { %> <em class="gear-bonus">(+<%= sheet.combat.gear.defense %>)</em><% } %></span>
      <span>SPD <strong><%= sheet.combat.effective.speed %></strong><% if (sheet.combat.gear.speed) { %> <em class="gear-bonus">(+<%= sheet.combat.gear.speed %>)</em><% } %></span>
      <span>DEX <strong><%= sheet.combat.effective.dexterity %></strong><% if (sheet.combat.gear.dexterity) { %> <em class="gear-bonus">(+<%= sheet.combat.gear.dexterity %>)</em><% } %></span>
      <span class="power-chip">Power <%= sheet.power %></span>
      <span class="hp-chip">HP <%= sheet.hp %>/<%= sheet.max_hp %></span>
    </div>
    <% var hpPct = sheet.max_hp ? Math.min(100, Math.round((sheet.hp / sheet.max_hp) * 100)) : 0; %>
    <div class="hp-meter" aria-hidden="true"><span class="hp-meter-fill" style="width:<%= hpPct %>%"></span></div>
    <p class="worker-line">Worker — LAB <strong><%= sheet.worker.effective.manual_labor %></strong> · INT <strong><%= sheet.worker.effective.intelligence %></strong> · END <strong><%= sheet.worker.effective.endurance %></strong> · TEC <strong><%= sheet.worker.effective.technique %></strong></p>
    <p class="worker-line"><a href="/character">Full character sheet</a> · <a href="/armory">Armory</a></p>
  </section>

  <section class="action-row">
    <article class="action-tile action-tile--train">
      <h3>Train combat</h3>
      <p class="tile-hint">−<%= trainCosts.ce %> morale · −<%= trainCosts.focus %> focus per set</p>
      <div class="tile-art tile-art--train" aria-hidden="true"></div>
      <form method="post" action="/train" class="tile-form">
        <select name="stat">
          <option value="strength">Strength</option>
          <option value="defense">Defense</option>
          <option value="speed">Speed</option>
          <option value="dexterity">Dexterity</option>
        </select>
        <input type="number" name="sets" value="5" min="1" max="20" aria-label="Sets" />
        <button type="submit" class="btn-realm">Train</button>
      </form>
    </article>

    <article class="action-tile action-tile--mission">
      <h3>Realm mission</h3>
      <div class="tile-art tile-art--mission" data-default="<%= missionImage %>" aria-hidden="true"></div>
      <form method="post" action="/crime" class="tile-form">
        <select name="mission">
          <% crimes.forEach(function(c) { %>
            <option value="<%= c.id %>" data-image="<%= c.imageUrl %>" <%= c.locked ? 'disabled' : '' %><%= c.id === defaultMission ? ' selected' : '' %>><%= c.name %> (Lv<%= c.min_level %>)<%= c.locked ? ' 🔒' : '' %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn-realm">Run</button>
      </form>
    </article>

    <article class="action-tile action-tile--worker">
      <h3>Worker training</h3>
      <p class="tile-hint">−<%= trainCosts.workerCe %> morale per set</p>
      <div class="tile-art tile-art--worker" aria-hidden="true"></div>
      <form method="post" action="/worker" class="tile-form">
        <select name="stat">
          <option value="manual_labor">Labor</option>
          <option value="intelligence">Intelligence</option>
          <option value="endurance">Endurance</option>
          <option value="technique">Technique</option>
        </select>
        <input type="number" name="sets" value="3" min="1" max="20" aria-label="Sets" />
        <button type="submit" class="btn-wood">Train</button>
      </form>
    </article>

    <article class="action-tile action-tile--wheel">
      <h3>Wheel of fate</h3>
      <form method="post" action="/wheel" class="wheel-form">
        <button type="submit" class="wheel-btn" aria-label="Spin wheel">
          <span class="wheel-disc" aria-hidden="true"></span>
          <span class="wheel-label">Spin</span>
        </button>
      </form>
      <form method="post" action="/work" class="work-chip">
        <p class="tile-hint work-hint"><%= status.company_name ? 'Company shift · ' + status.company_name : 'Job shift · ' + (status.job_name || 'Stable Hand') %></p>
        <button type="submit" class="btn-wood" <%= status.work_ready ? '' : 'disabled title="Work on cooldown"' %><% if (!status.work_ready && status.work_ready_at) { %> data-work-until="<%= status.work_ready_at %>"<% } %>>
          <%= status.work_ready ? 'Clock in' : ('Wait ' + status.work_minutes_left + 'm') %>
        </button>
      </form>
      <form method="post" action="/job" class="job-chip tile-form">
        <select name="jobId" aria-label="Job">
          <% jobs.forEach(function(j) { %>
          <option value="<%= j.id %>" <%= j.id === status.job_id ? 'selected' : '' %> <%= j.locked ? 'disabled' : '' %>><%= j.name %> (Lv<%= j.min_level %>)</option>
          <% }); %>
        </select>
        <button type="submit" class="btn-stone btn-sm">Set job</button>
      </form>
    </article>
  </section>

  <section class="bottom-row">
    <article class="lounge-panel">
      <h3>War Camp</h3>
      <p class="panel-sub">Rest &amp; rally · Feast 5 grain · Oath 10 grain</p>
      <div class="lounge-actions">
        <form method="post" action="/lounge">
          <input type="hidden" name="action" value="tea" />
          <button type="submit" class="lounge-btn">
            <img class="lounge-icon" src="<%= assetUrl('/public/assets/icons/feast.svg') %>" alt="Feast" width="32" height="32" />
            <span>Feast</span><em>+Focus</em>
          </button>
        </form>
        <form method="post" action="/lounge">
          <input type="hidden" name="action" value="vow" />
          <button type="submit" class="lounge-btn">
            <img class="lounge-icon" src="<%= assetUrl('/public/assets/icons/oath.svg') %>" alt="Oath of fealty" width="32" height="32" />
            <span>Oath of fealty</span><em>+Bravery</em>
          </button>
        </form>
        <form method="post" action="/lounge">
          <input type="hidden" name="action" value="refill" />
          <button type="submit" class="lounge-btn">
            <img class="lounge-icon" src="<%= assetUrl('/public/assets/icons/rally.svg') %>" alt="Rally morale" width="32" height="32" />
            <span>Rally morale</span><em>Full bar</em>
          </button>
        </form>
      </div>
      <% if (typeof drugDefs !== 'undefined' && drugDefs.length) { %>
      <div class="drug-quick-row">
        <% drugDefs.forEach(function(d) { %>
        <% var onCd = status.drug_cooldowns && status.drug_cooldowns[d.id]; %>
        <form method="post" action="/drug" class="drug-quick-form">
          <input type="hidden" name="drugId" value="<%= d.id %>" />
          <button type="submit" class="btn-stone btn-sm" <%= onCd ? 'disabled title="Cooldown"' : '' %>><%= d.name %><% if (onCd) { %> <%= onCd %>m<% } %></button>
        </form>
        <% }); %>
      </div>
      <% } %>
    </article>

    <article class="shelf-panel wood-shelf">
      <h3>Company</h3>
      <p class="panel-sub"><%= status.company_name ? status.company_name : 'No company — join to boost work shifts' %></p>
      <form method="post" action="/company" class="tile-form">
        <select name="companyId" aria-label="Company">
          <% companies.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= c.id === status.company_id ? 'selected' : '' %> <%= c.locked ? 'disabled' : '' %>><%= c.name %> (Lv<%= c.min_level %>)</option>
          <% }); %>
        </select>
        <button type="submit" class="btn-wood">Join</button>
      </form>
    </article>

    <article class="shelf-panel stone-frame">
      <h3>Guild</h3>
      <% if (playerGuild) { %>
      <p class="panel-sub">[<span><%= playerGuild.tag %></span>] <%= playerGuild.name %></p>
      <form method="post" action="/guild" class="tile-form">
        <input type="hidden" name="action" value="deposit" />
        <input type="number" name="amount" placeholder="Deposit gold" min="1" />
        <button type="submit" class="btn-realm">Deposit</button>
      </form>
      <form method="post" action="/guild" style="margin-top:6px">
        <input type="hidden" name="action" value="leave" />
        <button type="submit" class="btn-stone btn-sm">Leave guild</button>
      </form>
      <% } else { %>
      <p class="panel-sub">Found or join a player guild</p>
      <form method="post" action="/guild" class="tile-form">
        <input type="hidden" name="action" value="create" />
        <input name="name" placeholder="Guild name" required minlength="3" />
        <input name="tag" placeholder="TAG" required minlength="2" maxlength="5" />
        <button type="submit" class="btn-realm">Found</button>
      </form>
      <form method="post" action="/guild" class="tile-form" style="margin-top:6px">
        <input type="hidden" name="action" value="join" />
        <select name="guildId" aria-label="Guild">
          <% guilds.forEach(function(g) { %>
          <option value="<%= g.id %>">[<%= g.tag %>] <%= g.name %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn-wood">Join</button>
      </form>
      <% } %>
    </article>

    <article class="shelf-panel wood-shelf">
      <h3>Treasury</h3>
      <p class="panel-sub">Vault &amp; investments<% if (status.has_bank_card) { %> · Treasury Card active<% } else if (status.investment_amount) { %> · <%= status.investment_tier_id || 'investment' %> (×<%= status.investment_return_mult %>)<% } %></p>
      <form method="post" action="/bank" class="tile-form bank-form">
        <select name="action" id="bankAction">
          <option value="deposit">Deposit</option>
          <option value="withdraw">Withdraw</option>
          <option value="invest">Invest</option>
          <option value="collect">Collect</option>
          <% if (!status.has_bank_card) { %><option value="buycard">Buy Treasury Card</option><% } %>
        </select>
        <input type="number" name="amount" id="bankAmount" placeholder="Amount" />
        <% if (investmentTiers && investmentTiers.length) { %>
        <div class="invest-tier-wrap" id="investTierWrap" hidden>
          <select id="investTierGuide" aria-label="Investment tier reference">
            <% investmentTiers.forEach(function(t) { %>
            <option value="<%= t.id %>" data-min="<%= t.min %>" data-days="<%= t.days %>" data-mult="<%= t.returnMult %>">
              <%= t.id %> — <%= t.min.toLocaleString() %> min · <%= t.days %>d · ×<%= t.returnMult %>
            </option>
            <% }); %>
          </select>
          <p class="invest-preview" id="investPreview" aria-live="polite"></p>
        </div>
        <% } %>
        <button type="submit" class="btn-wood">Go</button>
      </form>
    </article>

    <article class="shelf-panel wood-shelf gear-shelf">
      <h3>Armory</h3>
      <p class="panel-sub">Equip &amp; training yard</p>
      <form method="post" action="/gym" class="tile-form tile-form--inline">
        <select name="gymId" aria-label="Training yard">
          <% gyms.forEach(function(g) { %>
          <option value="<%= g.id %>" <%= g.id === status.gym_id ? 'selected' : '' %> <%= g.locked ? 'disabled' : '' %>><%= g.name %> (×<%= g.train_multiplier %>)</option>
          <% }); %>
        </select>
        <button type="submit" class="btn-wood">Set yard</button>
      </form>
      <form method="post" action="/equip" class="tile-form">
        <select name="item" aria-label="Item to equip">
          <option value="">— Select gear —</option>
          <% equippable.forEach(function(i) { %>
          <option value="<%= i.item_id %>"><%= i.name %> ×<%= i.quantity %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn-realm" <%= equippable.length ? '' : 'disabled' %>>Equip</button>
      </form>
      <% if (sheet.equipped && sheet.equipped.length) { %>
      <ul class="equipped-list">
        <% sheet.equipped.forEach(function(eq) { %>
        <li class="equipped-slot">
          <span><%= eq.slot %>: <%= eq.name %></span>
          <form method="post" action="/unequip" class="inv-equip-form">
            <input type="hidden" name="slot" value="<%= eq.slot %>" />
            <input type="hidden" name="next" value="dashboard" />
            <button type="submit" class="btn-stone btn-sm">Unequip</button>
          </form>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </article>

    <aside class="inventory-panel mini-leaderboard-panel">
      <h3>Top lords</h3>
      <ol class="mini-leaderboard">
        <% if (typeof miniLeaderboard !== 'undefined') { miniLeaderboard.forEach(function(row, i) { %>
        <li><span class="lb-rank"><%= i + 1 %></span> <%= row.username %> · Lv.<%= row.level %></li>
        <% }); } %>
      </ol>
      <a href="/leaderboard">Full rankings →</a>
    </aside>

    <aside class="inventory-panel">
      <h3>Inventory</h3>
      <ul class="inventory-list">
        <% inventory.forEach(function(i) { %>
          <li class="inv-rarity inv-rarity--<%= i.rarity %>">
            <img class="inv-icon-img" src="<%= i.iconUrl %>" alt="<%= i.name %>" width="36" height="36" loading="lazy" />
            <span class="inv-text"><%= i.name %> ×<%= i.quantity %><% if (i.equip_slot) { %> <em>(<%= i.equip_slot %>)</em><% } %></span>
            <span class="inv-actions">
              <% if (i.usable) { %>
              <form method="post" action="/use" class="inv-use-form">
                <input type="hidden" name="item" value="<%= i.item_id %>" />
                <button type="submit" class="btn-inv-use">Use</button>
              </form>
              <% } %>
              <% if (i.equip_slot || ['weapon','armor','gear'].includes(i.item_type)) { %>
              <form method="post" action="/equip" class="inv-equip-form">
                <input type="hidden" name="item" value="<%= i.item_id %>" />
                <button type="submit" class="btn-inv-equip">Equip</button>
              </form>
              <% } %>
            </span>
          </li>
        <% }); %>
        <% if (!inventory.length) { %>
          <li class="inv-empty">Empty — <a href="/shop">visit shop</a></li>
        <% } %>
      </ul>
    </aside>
  </section>
</div>

<%- include('partials/realm-shell-close') %>
<script src="<%= assetUrl('/public/dashboard-interactions.js') %>" defer></script>
<%- include('partials/foot') %>
