<%- include('partials/head', { loggedIn: true, title: 'Launch 2D', pageClass: 'page-jjk' }) %>
<%- include('partials/jjk-shell-open') %>

<article class="jjk-panel vine-panel" style="max-width:640px;margin:1rem auto">
  <h1 class="page-title">2D mode</h1>
  <p class="page-lead"><strong>Recommended:</strong> join a voice channel in Discord → tap <strong>Activities</strong> (rocket) → launch the game. Works for everyone on mobile and desktop.</p>
  <p class="stat"><%= launch2dHint %></p>
  <p class="stat">Deploy: <a href="https://github.com/js91tech/jjkbot/blob/main/docs/RAILWAY-2D-ACTIVITY.md" target="_blank" rel="noopener">RAILWAY-2D-ACTIVITY.md</a></p>
  <% if (launch2dUrl) { %>
  <hr style="border-color:rgba(124,58,237,0.3);margin:1rem 0" />
  <p class="stat">Optional browser link (set <code>GAME_2D_URL</code> on web):</p>
  <p class="stat"><code style="word-break:break-all"><%= launch2dUrl %></code></p>
  <div class="profile-actions" style="margin-top:1rem">
    <a href="<%= launch2dUrl %>" class="btn-launch-2d" target="_blank" rel="noopener noreferrer">Open 2D in browser</a>
  <% } %>
    <a href="/dashboard" class="btn-wood">← Dashboard</a>
  </div>
</article>

<%- include('partials/jjk-shell-close') %>
<%- include('partials/foot') %>
