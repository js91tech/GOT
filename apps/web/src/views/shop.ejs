<%- include('partials/head', { loggedIn: true, title: 'Shop', pageClass: 'page-realm page-dashboard' }) %>
<%- include('partials/realm-shell-open') %>

<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<h1 class="page-title">Armory &amp; Supplies</h1>
<p class="page-lead">Spend gold on blades, armor, and provisions for the realm.</p>

<div class="realm-grid shop-grid">
<% items.forEach(function(item) { %>
  <article class="realm-panel wood-panel shop-card">
    <div class="shop-card-head">
      <div class="shop-icon-frame shop-icon-frame--<%= item.rarity %>"><img class="shop-item-icon" src="<%= item.iconUrl %>" alt="<%= item.name %>" width="56" height="56" loading="lazy" /></div>
      <div class="shop-item-meta">
        <strong><%= item.name %></strong>
        <span class="price"><%= item.shop_price.toLocaleString() %> gold</span>
        <span class="shop-type-tag"><%= item.item_type %></span>
      </div>
    </div>
    <p class="stat"><%= item.description %></p>
    <form method="post" action="/shop/buy">
      <input type="hidden" name="item" value="<%= item.id %>" />
      <input type="number" name="quantity" value="1" min="1" max="99" aria-label="Quantity" />
      <button type="submit" class="btn-realm">Buy</button>
    </form>
  </article>
<% }); %>
</div>

<a class="realm-back" href="/dashboard">← Dashboard</a>

<%- include('partials/realm-shell-close') %>
<%- include('partials/foot') %>
