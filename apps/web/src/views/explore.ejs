<%- include('partials/head', { loggedIn: true, title: 'Explore', pageClass: 'page-realm page-dashboard' }) %>
<link rel="stylesheet" href="<%= assetUrl('/public/dashboard-studio.css') %>" />
<%- include('partials/realm-shell-open') %>

<div class="dash-page dash-studio explore-page">
<% if (flash) { %><div class="map-flash explore-battle-log"><%= flash %></div><% } %>

<h1 class="page-title">Explore the Realm</h1>
<p class="page-lead">March through castles and wild lands — when a mob appears, choose to fight or flee.</p>

<% if (exploreView) { %>
<section class="explore-location-card" aria-label="Current location">
  <div class="explore-location-head">
    <span class="explore-location-emoji"><%= exploreView.roomEmoji || '🏰' %></span>
    <div>
      <h2 class="explore-location-title"><%= exploreView.areaName %> — <%= exploreView.roomName %></h2>
      <p class="explore-location-risk"><%= exploreView.riskLine %></p>
    </div>
  </div>
  <p class="explore-location-desc"><%= exploreView.description %></p>
  <div class="explore-location-meta">
    <% if (exploreView.exits && exploreView.exits.length) { %>
    <span class="explore-chip">Exits: <% exploreView.exits.forEach(function(e, i) { %><%= i ? ', ' : '' %><%= e.dir %>→<%= e.dest %><% }); %></span>
    <% } %>
    <% if (exploreView.npcs && exploreView.npcs.length) { %>
    <span class="explore-chip">NPCs: <% exploreView.npcs.map(function(n) { return n.name; }).join(', ') %></span>
    <% } %>
    <span class="explore-chip explore-chip--<%= exploreView.mineable ? 'ok' : 'muted' %>"><%= exploreView.mineable ? 'Prospectable' : 'No ore here' %></span>
  </div>
</section>
<% } else { %>
<pre class="explore-box"><%= exploreText %></pre>
<% } %>

<% if (pendingEncounter) { %>
<section class="realm-panel encounter-panel">
  <h2>⚠️ Encounter!</h2>
  <p class="encounter-mob">
    <strong><%= pendingEncounter.mob.emoji %> <%= pendingEncounter.mob.name %></strong>
    · Lv<%= pendingEncounter.mob.level %>
    · STR <%= pendingEncounter.mob.strength %>
    · DEF <%= pendingEncounter.mob.defense %>
    · HP <%= pendingEncounter.mob.hp %>
  </p>
  <p class="stat">Attack to fight for loot, or flee — fleeing can fail and leave you wounded.</p>
  <div class="encounter-actions">
    <form method="post" action="/explore">
      <input type="hidden" name="action" value="attack" />
      <button type="submit" class="btn-realm btn-attack">⚔️ Attack</button>
    </form>
    <form method="post" action="/explore">
      <input type="hidden" name="action" value="flee" />
      <button type="submit" class="btn-wood btn-flee">🏃 Flee</button>
    </form>
  </div>
</section>
<% } %>

<div class="realm-grid explore-actions <%= pendingEncounter ? 'explore-actions--blocked' : '' %>">
  <article class="realm-panel stone-frame">
    <h3>March</h3>
    <p class="stat"><%= pendingEncounter ? 'Resolve the encounter first.' : 'Mobs may ambush you in dangerous rooms.' %></p>
    <form method="post" action="/explore">
      <input type="hidden" name="action" value="move" />
      <select name="direction" <%= pendingEncounter ? 'disabled' : '' %>>
        <option value="north">North</option>
        <option value="south">South</option>
        <option value="east">East</option>
        <option value="west">West</option>
        <option value="up">Up</option>
      </select>
      <button type="submit" class="btn-realm" <%= pendingEncounter ? 'disabled' : '' %>>Go</button>
    </form>
  </article>
  <article class="realm-panel wood-panel">
    <h3>Travel</h3>
    <p class="stat">Higher regions — deadlier foes, better loot.</p>
    <form method="post" action="/explore">
      <input type="hidden" name="action" value="travel" />
      <select name="area" <%= pendingEncounter ? 'disabled' : '' %>>
        <option value="winterfell" <%= exploreView && exploreView.areaId === 'winterfell' ? 'selected' : '' %>>Winterfell (Lv1)</option>
        <option value="kings_landing" <%= exploreView && exploreView.areaId === 'kings_landing' ? 'selected' : '' %>>King's Landing (Lv5)</option>
        <option value="oldtown" <%= exploreView && exploreView.areaId === 'oldtown' ? 'selected' : '' %>>Oldtown (Lv10)</option>
        <option value="the_wall" <%= exploreView && exploreView.areaId === 'the_wall' ? 'selected' : '' %>>The Wall (Lv15)</option>
      </select>
      <button type="submit" class="btn-realm" <%= pendingEncounter ? 'disabled' : '' %>>Travel</button>
    </form>
  </article>
  <article class="realm-panel vine-panel">
    <h3>Hunt &amp; gather</h3>
    <form method="post" action="/explore"><input type="hidden" name="action" value="hunt" /><button type="submit" class="btn-realm" <%= pendingEncounter ? 'disabled' : '' %>>Hunt mobs</button></form>
    <form method="post" action="/explore" style="margin-top:8px"><input type="hidden" name="action" value="mine" /><button type="submit" class="btn-wood" <%= pendingEncounter ? 'disabled' : '' %> <%= exploreView && !exploreView.mineable ? 'title="Not mineable here"' : '' %>>Prospect land</button></form>
    <form method="post" action="/explore" style="margin-top:8px">
      <input type="hidden" name="action" value="talk" />
      <select name="npc" <%= pendingEncounter ? 'disabled' : '' %>>
        <% if (exploreView && exploreView.npcs && exploreView.npcs.length) { %>
          <% exploreView.npcs.forEach(function(n) { %>
          <option value="<%= n.id %>"><%= n.name %></option>
          <% }); %>
        <% } else { %>
        <option value="maester">Maester</option>
        <option value="goldcloak">Goldcloak Captain</option>
        <option value="septon">Septon</option>
        <option value="hedge_knight">Hedge Knight</option>
        <% } %>
      </select>
      <button type="submit" class="btn-wood" <%= pendingEncounter ? 'disabled' : '' %>>Parley</button>
    </form>
  </article>
</div>

<p class="page-lead"><a href="/armory">Armory</a> · <a href="/character">Character sheet</a> · <a href="/dashboard">Dashboard</a></p>
<a class="realm-back" href="/dashboard">← Dashboard</a>
</div>

<%- include('partials/realm-shell-close') %>
<%- include('partials/foot') %>
