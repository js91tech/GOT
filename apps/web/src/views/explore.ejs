<%- include('partials/head', { loggedIn: true, title: 'Explore', pageClass: 'page-realm' }) %>
<%- include('partials/realm-shell-open') %>

<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<h1 class="page-title">Explore the Realm</h1>
<p class="page-lead">March through castles, wild lands, and hidden keeps across Westeros.</p>

<pre class="explore-box"><%= exploreText %></pre>

<div class="realm-grid">
  <article class="realm-panel stone-frame">
    <h3>March</h3>
    <form method="post" action="/explore">
      <input type="hidden" name="action" value="move" />
      <select name="direction">
        <option value="north">North</option>
        <option value="south">South</option>
        <option value="east">East</option>
        <option value="west">West</option>
        <option value="up">Up</option>
      </select>
      <button type="submit" class="btn-realm">Go</button>
    </form>
  </article>
  <article class="realm-panel wood-panel">
    <h3>Travel</h3>
    <form method="post" action="/explore">
      <input type="hidden" name="action" value="travel" />
      <select name="area">
        <option value="tokyo_jujutsu_high">Winterfell</option>
        <option value="shibuya_district">King's Landing</option>
        <option value="jujutsu_high_kyoto">Oldtown</option>
        <option value="sakurajima_colony">The Wall</option>
      </select>
      <button type="submit" class="btn-realm">Travel</button>
    </form>
  </article>
  <article class="realm-panel vine-panel">
    <h3>Mine / Parley</h3>
    <form method="post" action="/explore"><input type="hidden" name="action" value="mine" /><button type="submit" class="btn-wood">Prospect land</button></form>
    <form method="post" action="/explore" style="margin-top:8px">
      <input type="hidden" name="action" value="talk" />
      <select name="npc"><option value="gojo">Maester</option><option value="yaga">Goldcloak Captain</option><option value="nanami">Septon</option><option value="maki">Hedge Knight</option></select>
      <button type="submit" class="btn-realm">Parley</button>
    </form>
  </article>
</div>

<a class="realm-back" href="/dashboard">← Dashboard</a>

<%- include('partials/realm-shell-close') %>
<%- include('partials/foot') %>
