<%- include('partials/head', { loggedIn: true, title: 'Explore', pageClass: 'page-realm' }) %>
<%- include('partials/jjk-shell-open') %>

<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<h1 class="page-title">Explore</h1>
<p class="page-lead">Navigate Tokyo High, colonies, and hidden rooms.</p>

<pre class="explore-box"><%= exploreText %></pre>

<div class="jjk-grid">
  <article class="jjk-panel stone-frame">
    <h3>Move</h3>
    <form method="post" action="/explore">
      <input type="hidden" name="action" value="move" />
      <select name="direction">
        <option value="north">North</option>
        <option value="south">South</option>
        <option value="east">East</option>
        <option value="west">West</option>
        <option value="up">Up</option>
      </select>
      <button type="submit" class="btn-curse">Go</button>
    </form>
  </article>
  <article class="jjk-panel wood-panel">
    <h3>Travel</h3>
    <form method="post" action="/explore">
      <input type="hidden" name="action" value="travel" />
      <select name="area">
        <option value="tokyo_jujutsu_high">Tokyo Jujutsu High</option>
        <option value="shibuya_district">Shibuya</option>
        <option value="jujutsu_high_kyoto">Kyoto</option>
        <option value="sakurajima_colony">Sakurajima</option>
      </select>
      <button type="submit" class="btn-curse">Travel</button>
    </form>
  </article>
  <article class="jjk-panel vine-panel">
    <h3>Mine / Talk</h3>
    <form method="post" action="/explore"><input type="hidden" name="action" value="mine" /><button type="submit" class="btn-wood">Mine room</button></form>
    <form method="post" action="/explore" style="margin-top:8px">
      <input type="hidden" name="action" value="talk" />
      <select name="npc"><option value="gojo">Gojo</option><option value="yaga">Yaga</option><option value="nanami">Nanami</option><option value="maki">Maki</option></select>
      <button type="submit" class="btn-curse">Talk</button>
    </form>
  </article>
</div>

<a class="jjk-back" href="/dashboard">← Dashboard</a>

<%- include('partials/jjk-shell-close') %>
<%- include('partials/foot') %>
