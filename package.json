{
  "name": "westeros-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Westeros-themed realm strategy MUD (Discord + Web + API in one stack)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:init": "npm run db:init -w @westeros/game-core",
    "start:bot": "npm start -w @westeros/discord-bot",
    "start:web": "npm start -w @westeros/web",
    "start:api": "npm start -w @westeros/api",
    "start:stack": "cross-env SERVICE=stack node scripts/railway-service-start.js",
    "start:railway": "node scripts/railway-service-start.js",
    "start": "cross-env SERVICE=stack node scripts/railway-service-start.js",
    "test": "npm test -w @westeros/game-core",
    "compress:portraits": "node scripts/compress-portraits.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "sharp": "^0.33.5"
  }
}
